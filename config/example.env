# Copy to config/local.env and edit. Do not commit real paths that hold private genotypes.

# PanSN: SAMPLE#HAP#chrNN  (e.g. PN40024#1#chr01)
REF_PATH="PN40024#1"
N_HAPS=8
THREADS=32

# Vitis vinifera-like haploid set
CHROMS="chr01 chr02 chr03 chr04 chr05 chr06 chr07 chr08 chr09 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19"

# Inputs: one FASTA per haplotype (chromosome-scale preferred)
HAP_FASTA_DIR="/path/to/haps"
WORK_DIR="/path/to/work"

# PGGB starting point for repetitive woody plants (tune with mash / pilot chr)
# Cannabis can-pan used stricter seeds (-s 100k -p 95); potato Nature used -p 90 -s 10k.
# Start mid, then tighten if you see spurious alignments.
PGGB_P=92
PGGB_S=20000
PGGB_K=49
PGGB_N=${N_HAPS}

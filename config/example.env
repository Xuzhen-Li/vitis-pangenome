# Copy to config/local.env and edit. Do not commit private genotype paths.

REF_PATH="PN40024#1"
N_HAPS=8
THREADS=32

CHROMS="chr01 chr02 chr03 chr04 chr05 chr06 chr07 chr08 chr09 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19"

HAP_FASTA_DIR="/path/to/haps"
WORK_DIR="/path/to/work"

# Grape-first PGGB start = North American Vitis playbook (Cochetel 2023):
#   wfmash -p 85 -s 10000. Retune after mash (pipeline/03).
# Cannabis can-pan used stricter -p 95 -s 100k; potato Nature often -p 90 -s 10k.
PGGB_P=85
PGGB_S=10000
PGGB_K=49
PGGB_N=${N_HAPS}

# VCF post (pipeline/09): max bubble length for vcfbub -r
VCFBUB_MAX=10000000
SV_LEN_MIN=50
